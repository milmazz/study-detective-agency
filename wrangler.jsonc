{
  // Tells `wrangler deploy` to publish dist/ as a static-assets-only
  // Worker — no custom script/logic, it just serves the files as-is
  // (equivalent to what Cloudflare Pages does). dist/ is what
  // `npm run build` (Vite) writes, so a deploy is always: build, then
  // deploy. `_headers` is copied into dist/ by the build (from public/)
  // and picked up automatically from this directory.
  "name": "study-detective-agency",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./dist",
    // Clean URLs: /foo.html redirects to /foo, and / still serves
    // index.html. This is already the default, spelled out here so it's
    // not relying on an unstated default. Every internal link in this
    // site is written extension-less to match, and the cleanUrls()
    // plugin in vite.config.mjs mimics the same resolution in dev.
    "html_handling": "auto-trailing-slash"
  }
}
